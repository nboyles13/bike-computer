<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bike.computer.DashboardView
        android:id="@+id/dash_view"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="94dp"/>
    <LinearLayout
        android:id="@+id/data_status"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:layout_width="match_parent"
        android:layout_height="22dp">
        <TextView
            android:id="@+id/data_status_time"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="--:--"/>
        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_battery"
            android:tint="#ff30d158"
            android:layout_marginEnd="5dp"/>
        <TextView
            android:id="@+id/data_status_batt"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#ffb0b0b0"
            android:gravity="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--%"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:id="@+id/dash_toolbar"
        android:background="#f2000000"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingRight="16dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:elevation="8dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ff4c8dff"
            android:id="@+id/dash_add"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="＋ Add box"
            android:layout_weight="1"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#ff8e8e93"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Drag to move · corner to resize · tap to change"
            android:layout_weight="1"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ff4c8dff"
            android:gravity="end"
            android:id="@+id/dash_done"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Done"
            android:layout_weight="1"/>
    </LinearLayout>
</FrameLayout>
