<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@android:color/black"
    android:paddingLeft="6dp"
    android:paddingTop="12dp"
    android:paddingRight="6dp"
    android:paddingBottom="94dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:text="HEART RATE ZONES"
        style="@style/CellLabel"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/card_solid"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="3dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_heart"
                android:tint="#ffff453a"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:textSize="52sp"
                android:textColor="#ffffffff"
                android:id="@+id/hr_big"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#ff9e9e9e"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  bpm"/>
        </LinearLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="#ff9e9e9e"
            android:gravity="end"
            android:id="@+id/hr_zone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <FrameLayout
        android:background="@drawable/card_solid"
        android:padding="6dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="3dp"
        android:layout_weight="1">
        <com.bike.computer.HrGraphView
            android:id="@+id/hr_graph"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/hr_legend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="3dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="3dp"/>
</LinearLayout>
