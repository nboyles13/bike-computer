<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@android:color/black"
    android:paddingLeft="6dp"
    android:paddingTop="12dp"
    android:paddingRight="6dp"
    android:paddingBottom="94dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RIDE SUMMARY"
            style="@style/CellLabel"/>
        <TextView
            android:id="@+id/data_status_time"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="--:--"/>
        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_battery"
            android:tint="#ff30d158"
            android:layout_marginEnd="5dp"/>
        <TextView
            android:id="@+id/data_status_batt"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#ffb0b0b0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--%"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="top"
            android:orientation="vertical"
            android:background="@drawable/card_solid"
            android:paddingLeft="14dp"
            android:paddingTop="11dp"
            android:paddingRight="10dp"
            android:paddingBottom="10dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_distance"
                    android:tint="#ff30d158"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISTANCE  mi"
                    android:includeFontPadding="false"
                    style="@style/CellLabel"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="44sp"
                    android:id="@+id/s_dist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00"
                    style="@style/CellValue"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="top"
            android:orientation="vertical"
            android:background="@drawable/card_solid"
            android:paddingLeft="14dp"
            android:paddingTop="11dp"
            android:paddingRight="10dp"
            android:paddingBottom="10dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_time"
                    android:tint="#ffff9f0a"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RIDE TIME"
                    android:includeFontPadding="false"
                    style="@style/CellLabel"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="36sp"
                    android:id="@+id/s_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00:00"
                    style="@style/CellValue"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="top"
            android:orientation="vertical"
            android:background="@drawable/card_solid"
            android:paddingLeft="14dp"
            android:paddingTop="11dp"
            android:paddingRight="10dp"
            android:paddingBottom="10dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_speed"
                    android:tint="#ff4c8dff"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AVG SPEED  mph"
                    android:includeFontPadding="false"
                    style="@style/CellLabel"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="42sp"
                    android:id="@+id/s_avgspd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    style="@style/CellValue"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="top"
            android:orientation="vertical"
            android:background="@drawable/card_solid"
            android:paddingLeft="14dp"
            android:paddingTop="11dp"
            android:paddingRight="10dp"
            android:paddingBottom="10dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_speed"
                    android:tint="#ff4c8dff"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MAX SPEED  mph"
                    android:includeFontPadding="false"
                    style="@style/CellLabel"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="42sp"
                    android:id="@+id/s_maxspd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    style="@style/CellValue"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="top"
            android:orientation="vertical"
            android:background="@drawable/card_solid"
            android:paddingLeft="14dp"
            android:paddingTop="11dp"
            android:paddingRight="10dp"
            android:paddingBottom="10dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_heart"
                    android:tint="#ffff453a"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AVG HR  bpm"
                    android:includeFontPadding="false"
                    style="@style/CellLabel"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="42sp"
                    android:id="@+id/s_avghr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    style="@style/CellValue"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="top"
            android:orientation="vertical"
            android:background="@drawable/card_solid"
            android:paddingLeft="14dp"
            android:paddingTop="11dp"
            android:paddingRight="10dp"
            android:paddingBottom="10dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_heart"
                    android:tint="#ffff453a"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MAX HR  bpm"
                    android:includeFontPadding="false"
                    style="@style/CellLabel"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="42sp"
                    android:id="@+id/s_maxhr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    style="@style/CellValue"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="top"
            android:orientation="vertical"
            android:background="@drawable/card_solid"
            android:paddingLeft="14dp"
            android:paddingTop="11dp"
            android:paddingRight="10dp"
            android:paddingBottom="10dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_elevation"
                    android:tint="#ffbf5af2"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL ASCENT  ft"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.03"
                    style="@style/CellLabel"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="42sp"
                    android:id="@+id/s_ascent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    style="@style/CellValue"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="top"
            android:orientation="vertical"
            android:background="@drawable/card_solid"
            android:paddingLeft="14dp"
            android:paddingTop="11dp"
            android:paddingRight="10dp"
            android:paddingBottom="10dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_time"
                    android:tint="#ffff9f0a"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STARTED"
                    android:includeFontPadding="false"
                    style="@style/CellLabel"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="36sp"
                    android:id="@+id/s_started"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    style="@style/CellValue"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
