<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/nav_banner"
            android:background="@drawable/card_bg"
            android:paddingLeft="18dp"
            android:paddingTop="12dp"
            android:paddingRight="14dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="8dp"
            android:elevation="6dp">
            <TextView
                android:textSize="66sp"
                android:textStyle="bold"
                android:textColor="#ff4c8dff"
                android:id="@+id/nav_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↑"
                android:layout_marginEnd="18dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="#ffffffff"
                    android:id="@+id/nav_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Continue"/>
                <TextView
                    android:textSize="23sp"
                    android:textColor="#ffb0b0b0"
                    android:id="@+id/nav_dist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:paddingLeft="18dp"
            android:paddingTop="10dp"
            android:paddingRight="18dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:elevation="6dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="92dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_speed"
                            android:tint="#ff4c8dff"
                            android:layout_marginEnd="5dp"/>
                        <TextView
                            android:textSize="13sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SPEED"
                            style="@style/CellLabel"/>
                    </LinearLayout>
                    <TextView
                        android:textStyle="bold"
                        android:textColor="#ffffffff"
                        android:gravity="start|center_vertical"
                        android:id="@+id/val_speed"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:text="0.0"
                        android:maxLines="1"
                        android:layout_weight="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeMinTextSize="30sp"
                        android:autoSizeMaxTextSize="84sp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_heart"
                            android:tint="#ffff453a"
                            android:layout_marginEnd="5dp"/>
                        <TextView
                            android:textSize="13sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HR"
                            style="@style/CellLabel"/>
                    </LinearLayout>
                    <TextView
                        android:textStyle="bold"
                        android:textColor="#ffffffff"
                        android:gravity="start|center_vertical"
                        android:id="@+id/val_hr"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:text="--"
                        android:maxLines="1"
                        android:layout_weight="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeMinTextSize="30sp"
                        android:autoSizeMaxTextSize="84sp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="6dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_distance"
                            android:tint="#ff30d158"
                            android:layout_marginEnd="5dp"/>
                        <TextView
                            android:textSize="13sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DIST"
                            style="@style/CellLabel"/>
                    </LinearLayout>
                    <TextView
                        android:textStyle="bold"
                        android:textColor="#ffffffff"
                        android:gravity="start|center_vertical"
                        android:id="@+id/val_dist"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:text="0.00"
                        android:maxLines="1"
                        android:layout_weight="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeMinTextSize="30sp"
                        android:autoSizeMaxTextSize="84sp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_time"
                            android:tint="#ffff9f0a"
                            android:layout_marginEnd="5dp"/>
                        <TextView
                            android:textSize="13sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TIME"
                            style="@style/CellLabel"/>
                    </LinearLayout>
                    <TextView
                        android:textStyle="bold"
                        android:textColor="#ffffffff"
                        android:gravity="start|center_vertical"
                        android:id="@+id/val_time"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:text="0:00:00"
                        android:maxLines="1"
                        android:layout_weight="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeMinTextSize="24sp"
                        android:autoSizeMaxTextSize="84sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:layout_gravity="start|bottom"
        android:id="@+id/home_btn"
        android:background="@drawable/home_btn_bg"
        android:padding="17dp"
        android:visibility="invisible"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_marginBottom="28dp"
        android:src="@drawable/ic_home"
        android:tint="#ffffffff"
        android:layout_marginStart="20dp"
        android:elevation="8dp"/>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/recenter_btn"
        android:background="@drawable/mode_bg"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_marginBottom="28dp"
        android:src="@drawable/ic_recenter"
        android:tint="#ff202124"
        android:layout_marginEnd="20dp"
        android:elevation="6dp"/>
</FrameLayout>
