<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">
        <TextView
            android:textSize="12sp"
            android:textColor="#ffffffff"
            android:id="@+id/dot0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:text="●"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ffffffff"
            android:id="@+id/dot1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:text="●"
            android:alpha="0.35"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ffffffff"
            android:id="@+id/dot2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:text="●"
            android:alpha="0.35"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ffffffff"
            android:id="@+id/dot3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:text="●"
            android:alpha="0.35"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ffffffff"
            android:id="@+id/dot4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:text="●"
            android:alpha="0.35"/>
    </LinearLayout>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#fff5a623"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/paused_badge"
        android:background="@drawable/card_bg"
        android:paddingLeft="16dp"
        android:paddingTop="6dp"
        android:paddingRight="16dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="92dp"
        android:text="● PAUSED"/>
    <TextView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/rec_btn"
        android:background="@drawable/rec_btn_ripple"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_marginBottom="28dp"
        android:contentDescription="Start recording"
        android:elevation="8dp"/>
    <LinearLayout
        android:layout_gravity="bottom|center_horizontal"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/rec_bar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/pause_btn"
            android:background="@drawable/btn_dark_ripple"
            android:layout_width="124dp"
            android:layout_height="48dp"
            android:text="❚❚  Pause"
            android:elevation="4dp"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/resume_btn"
            android:background="@drawable/btn_dark_ripple"
            android:visibility="gone"
            android:layout_width="84dp"
            android:layout_height="48dp"
            android:text="▶  Resume"
            android:layout_marginEnd="8dp"
            android:elevation="4dp"/>
        <FrameLayout
            android:id="@+id/stop_btn"
            android:background="@drawable/rec_rect_bg"
            android:visibility="gone"
            android:layout_width="96dp"
            android:layout_height="48dp"
            android:elevation="4dp"
            android:clipToOutline="true">
            <View
                android:id="@+id/stop_fill"
                android:background="@drawable/stop_fill_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleX="0"/>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@+id/stop_label"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="■  Stop"/>
        </FrameLayout>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/bell_btn"
        android:background="@drawable/bell_btn_ripple"
        android:padding="12dp"
        android:visibility="invisible"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_bell"
        android:contentDescription="Ring bell"
        android:layout_marginEnd="12dp"
        android:elevation="8dp"/>
</FrameLayout>
